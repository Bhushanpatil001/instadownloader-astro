---
import PlatformIcon from "./PlatformIcon.astro";
import { ui } from "../data/i18n.js";

const { lang = 'en' } = Astro.props;
const t = { ...ui.en, ...ui[lang] };

const getLocalizedHref = (slug) => {
  if (slug.startsWith('/') && slug !== '/') {
     const s = slug.startsWith('/') ? slug.slice(1) : slug;
     return lang === 'en' ? `/${s}` : `/${lang}/${s}`;
  }
  if (slug === '/') return lang === 'en' ? '/' : `/${lang}`;
  return lang === 'en' ? `/${slug}` : `/${lang}/${slug}`;
};

const dlLabel = t['common.downloader'] || 'Downloader';

const DOWNLOADERS = [
  { href: getLocalizedHref('instagram'),                  label: `${t['nav.instagram']} ${dlLabel}`,        platform: 'instagram', color: '#e1306c' },
  { href: getLocalizedHref('instagram-reels-downloader'), label: `${t['nav.instagram_reels']} ${dlLabel}`,  platform: 'instagram', color: '#e1306c' },
  { href: getLocalizedHref('yt'),                         label: `${t['nav.youtube']} ${dlLabel}`,          platform: 'youtube',   color: '#ff0000' },
  { href: getLocalizedHref('youtube-shorts-downloader'),  label: `${t['nav.youtube_shorts']} ${dlLabel}`,   platform: 'youtube',   color: '#ff0000' },
  { href: getLocalizedHref('facebook'),                   label: `${t['nav.facebook']} ${dlLabel}`,         platform: 'facebook',  color: '#1877f2' },
  { href: getLocalizedHref('pinterest'),                  label: `${t['nav.pinterest']} ${dlLabel}`,        platform: 'pinterest', color: '#e60023' },
  { href: getLocalizedHref('x'),                          label: `${t['nav.x']} ${dlLabel}`,      platform: 'x',         color: '#8a8a8a' },
  { href: getLocalizedHref('tiktok'),                     label: `${t['nav.tiktok']} ${dlLabel}`,           platform: 'tiktok',    color: '#00f2ea' },
];

const COMPANY = [
  { href: '/about',   label: t['footer.about']   },
  { href: '/contact', label: t['footer.contact'] },
  { href: '/sitemap', label: t['footer.sitemap']    },
];
const LEGAL = [
  { href: '/privacy-policy', label: t['footer.privacy'] },
  { href: '/terms',          label: t['footer.terms']   },
  { href: '/disclaimer',     label: t['footer.disclaimer']     },
  { href: '/cookies-policy', label: t['footer.cookies'] },
];
const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--bdr)] mt-auto" style="background:var(--bg-surf); padding:48px 24px 28px;">
  <div class="max-w-[1100px] mx-auto grid gap-8" style="grid-template-columns:1.6fr 1fr 1fr 1fr;">
    <!-- Brand -->
    <div>
      <a href={getLocalizedHref('/')} class="inline-block text-[1.3rem] font-black mb-3"
        style="background:var(--g-brand);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">
        ⬇ {t['common.downloader']}
      </a>
      <p class="text-[0.85rem] leading-relaxed max-w-[280px]" style="color:var(--txt3);">
        {t['footer.desc']}
      </p>
    </div>

    <!-- Tools -->
    <div>
      <p class="text-[0.78rem] font-bold uppercase tracking-widest mb-4" style="color:var(--txt3);">{t['footer.tools']}</p>
      <ul class="flex flex-col gap-[10px] list-none">
        {DOWNLOADERS.map(({ href, label, platform, color }) => (
          <li>
            <a href={href} class="text-[0.88rem] transition-colors hover:text-[var(--txt)] flex items-center gap-2" style="color:var(--txt2);">
              <PlatformIcon platform={platform} size={14} class="opacity-70 group-hover:opacity-100" />
              <span>{label}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Company -->
    <div>
      <p class="text-[0.78rem] font-bold uppercase tracking-widest mb-4" style="color:var(--txt3);">{t['footer.company']}</p>
      <ul class="flex flex-col gap-[10px] list-none">
        {COMPANY.map(({ href, label }) => (
          <li><a href={href} class="text-[0.88rem] transition-colors hover:text-[var(--txt)]" style="color:var(--txt2);">{label}</a></li>
        ))}
      </ul>
    </div>

    <!-- Legal -->
    <div>
      <p class="text-[0.78rem] font-bold uppercase tracking-widest mb-4" style="color:var(--txt3);">{t['footer.legal']}</p>
      <ul class="flex flex-col gap-[10px] list-none">
        {LEGAL.map(({ href, label }) => (
          <li><a href={href} class="text-[0.88rem] transition-colors hover:text-[var(--txt)]" style="color:var(--txt2);">{label}</a></li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Bottom -->
  <div class="max-w-[1100px] mx-auto mt-10 pt-6 flex flex-wrap items-center justify-between gap-4 border-t border-[var(--bdr)]">
    <span class="text-[0.8rem]" style="color:var(--txt3);">© {year} {t['footer.made_by']}</span>
    <div class="flex flex-wrap gap-5">
      {LEGAL.map(({ href, label }) => (
        <a href={href} class="text-[0.78rem] transition-colors hover:text-[var(--txt)]" style="color:var(--txt3);">{label}</a>
      ))}
    </div>
  </div>
</footer>

<style>
  @media(max-width:1024px){footer div.grid{grid-template-columns:1fr 1fr!important; gap: 40px;}}
  @media(max-width:520px){footer div.grid{grid-template-columns:1fr!important;}}
</style>
