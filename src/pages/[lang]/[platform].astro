---
export const prerender = false;
import PageLayout from '../../layouts/PageLayout.astro';
import DownloaderWidget from '../../components/react/DownloaderWidget.jsx';
import TopicMediaList from '../../components/react/TopicMediaList.jsx';
import TrendingDownloads from '../../components/TrendingDownloads.astro';
import FAQItem from '../../components/FAQItem.astro';
import PlatformIcon from '../../components/PlatformIcon.astro';
import TryOtherPlatforms from '../../components/TryOtherPlatforms.astro';
import { languages, platforms, ui } from '../../data/i18n.js';
import { getTrendingData } from '../../services/trendingService';

const { lang, platform } = Astro.params;

if (!lang || !languages[lang] || !platform || !platforms[platform]) {
  return Astro.redirect('/404');
}

const { platformConfigs } = await getTrendingData();
const pSeoConfig = { platformConfigs };

const isTrending = false;
const platformKey = platform;
const topic = '';
const displayName = '';
const t = { ...ui.en, ...ui[lang] };

// --- LOGIC FOR STANDARD PLATFORMS ---
const pData = !isTrending ? (platforms[platform]?.[lang] || platforms[platform]?.en || {}) : {};
const steps = pData.steps || (platforms[platform]?.en?.steps) || [];
const faqs = pData.faqs || (platforms[platform]?.en?.faqs) || [];
const platformMapping = {
  instagram: 'ig',
  youtube: 'yt',
  yt: 'yt',
  facebook: 'fb',
  tiktok: 'tiktok',
  pinterest: 'pinterest',
  x: 'twitter',
  'instagram-reels-downloader': 'ig',
  'youtube-shorts-downloader': 'yt'
};
const internalPlatform = platformMapping[platform] || platform;
const apiEndpointMapping = {
  'instagram-reels-downloader': '/instagram/download',
  'youtube-shorts-downloader': '/youtube/download',
  'yt': '/youtube/download',
  'youtube': '/youtube/download'
};
const apiEndpoint = apiEndpointMapping[platform] || `/${platform}/download`;

// --- LOGIC FOR TRENDING TOPICS ---
let trendingTitle = '';
let trendingDesc = '';
let topicData = [];
let trendingFaqs = [];

if (isTrending) {
  const platformInfo = pSeoConfig.platformConfigs[platformKey];
  const formattedTopic = displayName || topic.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
  
  trendingTitle = `${platformKey === 'instagram' ? (t['trending.reels_prefix'] || 'Download Instagram Reels about') : (t['trending.video_prefix'] || 'Download Video about')} ${formattedTopic}`;
  trendingDesc = `${t['trending.desc_prefix'] || 'Download the latest videos and content from'} ${formattedTopic} ${t['trending.on'] || 'on'} ${platformInfo.name}. ${t['trending.desc_suffix'] || 'Free, fast, and no watermark 2026.'}`;

  const trendingItem = pSeoConfig.trending.find(tr => tr.slug === topic);
  const trendingUrls = trendingItem?.platforms[platformKey] || [];
  topicData = trendingUrls.map((url, i) => ({ 
    title: `${formattedTopic} ${platformInfo.name} ${i+1}`, 
    url 
  }));

  trendingFaqs = [
    { q: `${t['faq.free_q_prefix'] || 'Is it free to download'} ${platformInfo.name} ${t['faq.content_here'] || 'content here?'}`, a: t['faq.free_a'] || 'Yes, our platform is 100% free with no hidden charges or premium subscriptions.' },
    { q: t['faq.account_q'] || 'Do I need an account to use this?', a: t['faq.account_a'] || 'No registration is required. You can save any public content instantly without logging in.' },
    { q: t['faq.limit_q'] || 'Is there a limit on how many I can download?', a: t['faq.limit_a'] || 'There are no limits. You can download as many videos or photos as you need daily.' }
  ];
}
---

<PageLayout
  title={isTrending ? `${trendingTitle} — ${t['common.downloader']} 2026` : (pData.title || t['home.title'])}
  description={isTrending ? trendingDesc : (pData.desc || t['home.desc'])}
  keywords={pData.keywords}
>
  <div class="max-w-[1100px] mx-auto px-6 py-5">
    {isTrending ? (
      <section class="pt-10 pb-10">
        <div class="text-center mb-16 relative overflow-hidden">
          <div class="absolute -top-10 left-1/2 -translate-x-1/2 w-[400px] h-[400px] rounded-full pointer-events-none -z-0"
            style={`background:radial-gradient(ellipse,rgba(124,58,237,0.15) 0%,transparent 70%);`} />
          
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-[0.75rem] font-bold uppercase tracking-wider mb-5 relative z-10"
            style={`background:rgba(124,58,237,0.1); border:1px solid rgba(124,58,237,0.3); color:var(--brand2);`}>
            <PlatformIcon platform={platformKey} size={14} />
            <span>{platformKey.toUpperCase()} {t['common.exclusive'] || 'EXCLUSIVE'}</span>
          </div>

          <h1 class="text-[2.8rem] font-black leading-[1.1] mb-5 relative z-10" style="color:var(--txt);">
            {trendingTitle}
          </h1>
          
          <p class="text-[1.1rem] max-w-[600px] mx-auto opacity-70 relative z-10">
            {trendingDesc}
          </p>
        </div>

        <TopicMediaList 
          client:load 
          platform={platformKey} 
          apiEndpoint={apiEndpoint} 
          topicData={topicData} 
          lang={lang}
        />

        <div class="mt-24 pt-16 border-t border-[var(--bdr)]">
          <h2 class="text-[1.8rem] font-black mb-10 text-center" style="color:var(--txt);">{t['trending.why_h2'] || `Why Download Content With Us?`}</h2>
          
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
            <div class="p-8 rounded-[24px] border border-[var(--bdr)] relative group" style="background:var(--bg-glass);">
              <div class="text-[2.2rem] mb-4">💎</div>
              <h3 class="text-[1.1rem] font-bold mb-3" style="color:var(--txt);">{t['home.quality_h3'] || 'Original Quality'}</h3>
              <p class="text-[0.85rem] leading-relaxed" style="color:var(--txt3);">{t['home.quality_p'] || 'We fetch the highest resolution available directly from the source servers.'}</p>
            </div>
            <div class="p-8 rounded-[24px] border border-[var(--bdr)] relative group" style="background:var(--bg-glass);">
              <div class="text-[2.2rem] mb-4">🚀</div>
              <h3 class="text-[1.1rem] font-bold mb-3" style="color:var(--txt);">{t['home.speed_h3'] || 'Instant Processing'}</h3>
              <p class="text-[0.85rem] leading-relaxed" style="color:var(--txt3);">{t['home.speed_p'] || 'No long waiting times. Our high-speed engine generates links in seconds.'}</p>
            </div>
            <div class="p-8 rounded-[24px] border border-[var(--bdr)] relative group" style="background:var(--bg-glass);">
              <div class="text-[2.2rem] mb-4">🛡️</div>
              <h3 class="text-[1.1rem] font-bold mb-3" style="color:var(--txt);">{t['home.safe_h3'] || 'Safe & Anonymous'}</h3>
              <p class="text-[0.85rem] leading-relaxed" style="color:var(--txt3);">{t['home.safe_p'] || 'We don\'t store your data. Your browsing is private and secure.'}</p>
            </div>
          </div>

          <h2 class="text-[1.8rem] font-black mb-10 text-center" style="color:var(--txt);">{t['common.faq']}</h2>
          <div class="max-w-[800px] mx-auto space-y-4 mb-20">
            {trendingFaqs.map(faq => (
              <FAQItem q={faq.q} a={faq.a} />
            ))}
          </div>

          <TrendingDownloads lang={lang} />
          <TryOtherPlatforms current="trending" lang={lang} />
        </div>
      </section>
    ) : (
      <>
        <div class="text-center mb-6">
          <h1 class="text-[clamp(1.8rem,4vw,2.8rem)] font-black mb-1 leading-tight" style="color:var(--txt);">
            {pData.h1 || t['home.h1']}
          </h1>
          <p class="text-lg opacity-70 max-w-[700px] mx-auto">
            {pData.subtitle || t['home.subtitle']}
          </p>
        </div>

        <DownloaderWidget
          client:load
          platform={internalPlatform}
          apiEndpoint={apiEndpoint}
          placeholder={t['common.placeholder']}
          lang={lang}
        >
          {pData.content && (
            <div class="seo-content-section mt-12">
                <p class="seo-p">{pData.content}</p>
            </div>
          )}
          
          {steps && steps.length > 0 && (
            <div class="mt-12">
              <h2 class="text-2xl font-bold mb-8 text-center" style="color:var(--txt);">{t['common.how_to'] || "How to Use"}</h2>
              <div class="p-8 rounded-[24px] border border-[var(--bdr)]" style="background:var(--bg-glass);">
                  <ol class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-8 list-none p-0">
                    {steps.map((s, i) => (
                      <li class="flex gap-4">
                        <span class="flex-shrink-0 w-8 h-8 rounded-full flex items-center justify-center font-bold text-white text-sm bg-[var(--brand)]">{i + 1}</span>
                        <div>
                          <strong class="block mb-1 font-bold" style="color:var(--txt);">{s.step}</strong>
                          <p class="text-[0.85rem] opacity-60 leading-relaxed">{s.detail}</p>
                        </div>
                      </li>
                    ))}
                  </ol>
              </div>
            </div>
          )}

          {faqs && faqs.length > 0 && (
            <div class="mt-16">
                <h2 class="text-2xl font-bold mb-8 text-center" style="color:var(--txt);">{t['common.faq'] || "Frequently Asked Questions"}</h2>
                <div class="space-y-3">
                  {faqs.map(faq => <FAQItem q={faq.q} a={faq.a} />)}
                </div>
            </div>
          )}
        </DownloaderWidget>

        <div class="mt-16 pt-16 border-t border-[var(--bdr)]">
          <TrendingDownloads lang={lang} />
        </div>

        <div class="mt-12">
           <TryOtherPlatforms current={platform} lang={lang} />
        </div>

        <div class="mt-12 text-center">
          <p class="opacity-50 text-sm">
            {t['common.secure_p'] || 'Secure and free downloader.'}
          </p>
        </div>
      </>
    )}
  </div>
</PageLayout>
