---
import PageLayout from '../../layouts/PageLayout.astro';
import TopicMediaList from '../../components/react/TopicMediaList.jsx';
import TryOtherPlatforms from '../../components/TryOtherPlatforms.astro';
import FAQItem from '../../components/FAQItem.astro';
import PlatformIcon from '../../components/PlatformIcon.astro';
import TrendingDownloads from '../../components/TrendingDownloads.astro';
import { languages, ui, platforms } from '../../data/i18n.js';
import { getTrendingData } from '../../services/trendingService';

// Force SSR to instantly reflect CMS changes without rebuild
export const prerender = false;

// Dynamically read the latest trending data
const pSeoConfig = await getTrendingData();

const { lang, platform: platSlug, topic: topicSlug } = Astro.params;

// 404 if invalid language
if (!lang || !(languages as any)[lang as string] || lang === 'en') {
  return Astro.redirect('/404');
}

// Resolve the internal platform key from the URL slug (mapping to i18n keys and trending configs)
const i18nPlatform = platSlug === 'instagram-reel' ? 'instagram' : 
                     platSlug === 'youtube-short' ? 'yt' : 
                     platSlug === 'facebook-video' ? 'facebook' : 
                     platSlug === 'pinterest-video' ? 'pinterest' : 
                     platSlug === 'x-video' ? 'x' : 
                     (platSlug === 'youtube' ? 'yt' : platSlug);

const configPlatform = platSlug === 'instagram-reel' ? 'instagram' : 
                       platSlug === 'youtube-short' ? 'youtube' : 
                       platSlug === 'facebook-video' ? 'facebook' : 
                       platSlug === 'pinterest-video' ? 'pinterest' : 
                       platSlug === 'x-video' ? 'x' : 
                       (platSlug === 'youtube' ? 'youtube' : platSlug);

// 404 if config is missing for this platform
if (!configPlatform || !(pSeoConfig.platformConfigs as any)[configPlatform as string]) {
  return Astro.redirect('/404');
}

// Find the topic in the trending data
const trendingItem: any = pSeoConfig.trending.find((t: any) => t.slug === topicSlug);

if (!trendingItem || !trendingItem.platforms[configPlatform as string] || trendingItem.platforms[configPlatform as string].length === 0) {
  return Astro.redirect('/404');
}

// Get translated strings - merge English defaults with language-specific translations
const t = { ...ui.en, ...((ui as any)[lang as string] || {}) };

// Get platform data from i18n with fallback
const pData = (platforms as any)[i18nPlatform as string]?.[lang as string] || (platforms as any)[i18nPlatform as string]?.en || {};
const STEPS = pData.steps || (platforms as any)[i18nPlatform as string]?.en?.steps || [];

// Get translated platform name
const translatedPlatformName = t[`platform.${i18nPlatform}` as keyof typeof t] || ((pSeoConfig.platformConfigs as any)[configPlatform as string] as any).name;
const displayName = trendingItem.name;
const platformInfo: any = (pSeoConfig.platformConfigs as any)[configPlatform as string];

// Build title and description with translated platform name
const formattedTopic = displayName || (topicSlug || '').replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase());

// Use translation function to build title
const titlePrefix = i18nPlatform === 'instagram' ? t['trending.reels_prefix'] : t['trending.video_prefix'];

const title = `${translatedPlatformName} — ${formattedTopic}`;
const description = `${t['trending.desc_prefix']} ${formattedTopic} ${t['trending.on']} ${translatedPlatformName}. ${t['trending.desc_suffix']}`;

const endpointMap: Record<string, string> = {
  instagram: `/instagram/download`,
  youtube: `/youtube/download`,
  facebook: `/facebook/download`,
  pinterest: `/pinterest/download`,
  x: `/x/download`
};

const trendingUrls = (trendingItem.platforms[configPlatform as string] || []) as string[];

// Convert simple URLs from trending to the {title, url} format used by TopicMediaList
const topicData = trendingUrls.map((url: string, i: number) => ({ 
  title: `${formattedTopic} ${translatedPlatformName} ${i+1}`, 
  url 
}));

// FAQ questions translated
const FAQS = [
  { 
    q: `${t['faq.free_q_prefix']} ${translatedPlatformName} ${t['faq.content_here']}`,
    a: t['faq.free_a']
  },
  { 
    q: t['faq.account_q'], 
    a: t['faq.account_a']
  },
  { 
    q: t['faq.limit_q'], 
    a: t['faq.limit_a']
  }
];
---

<PageLayout
  title={`${title} — Downloader 2026`}
  description={description}
>
  <section class="max-w-6xl mx-auto px-5 pt-14 pb-20">
    <!-- Hero -->
    <div class="text-center mb-16 relative overflow-hidden">
      <div class="absolute -top-10 left-1/2 -translate-x-1/2 w-96 h-96 rounded-full pointer-events-none z-0"
        style={`background:radial-gradient(ellipse,${platformInfo.color.replace('var(--grad-', '#7c3aed').replace(')', '')}22 0%,transparent 70%);`} />
      
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-[0.75rem] font-bold uppercase tracking-wider mb-5 relative z-10"
        style={`background:rgba(124,58,237,0.1); border:1px solid rgba(124,58,237,0.3); color:var(--brand2);`}>
        <PlatformIcon platform={i18nPlatform} size={14} />
        <span>{t['common.exclusive']}</span>
      </div>

      <h1 class="text-[2.8rem] font-black leading-[1.1] mb-5 relative z-10" style="color:var(--txt);">
        {translatedPlatformName}
        <span style={`color:${platformInfo.color.replace('var(--grad-', '#a78bfa').replace(')', '')};`}> {formattedTopic}</span>
      </h1>
      
      <p class="text-lg max-w-2xl mx-auto opacity-70 relative z-10">
        {description}
      </p>
    </div>

    <TopicMediaList 
      client:load 
      platform={i18nPlatform} 
      apiEndpoint={endpointMap[configPlatform]} 
      topicData={topicData} 
      t={t}
    />

    <!-- SEO Content -->
    <div class="mt-24 pt-16 border-t border-gray-200" style="border-color: var(--bdr)">
      <h2 class="text-3xl font-black mb-10 text-center" style="color:var(--txt);">
        {`${t['trending.why_h2']} ${formattedTopic} ${t['trending.on']} ${translatedPlatformName}?` || 'Why Download Content With Us?'}
      </h2>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
        <div class="p-8 rounded-3xl border border-gray-300 relative group" style="background:var(--bg-glass); border-color: var(--bdr);">
          <div class="text-5xl mb-4">💎</div>
          <h3 class="text-lg font-bold mb-3" style="color:var(--txt);">{t['home.quality_h3']}</h3>
          <p class="text-sm leading-relaxed" style="color:var(--txt3);">{t['home.quality_p']}</p>
        </div>
        <div class="p-8 rounded-3xl border border-gray-300 relative group" style="background:var(--bg-glass); border-color: var(--bdr);">
          <div class="text-5xl mb-4">🚀</div>
          <h3 class="text-lg font-bold mb-3" style="color:var(--txt);">{t['home.speed_h3']}</h3>
          <p class="text-sm leading-relaxed" style="color:var(--txt3);">{t['home.speed_p']}</p>
        </div>
        <div class="p-8 rounded-3xl border border-gray-300 relative group" style="background:var(--bg-glass); border-color: var(--bdr);">
          <div class="text-5xl mb-4">🛡️</div>
          <h3 class="text-lg font-bold mb-3" style="color:var(--txt);">{t['home.safe_h3']}</h3>
          <p class="text-sm leading-relaxed" style="color:var(--txt3);">{t['home.safe_p']}</p>
        </div>
      </div>

      {STEPS.length > 0 && (
        <div class="mb-20">
          <h2 class="text-3xl font-black mb-10 text-center" style="color:var(--txt);">{t['common.how_to'] || "How to Use"}</h2>
          <div class="p-8 rounded-[24px] border border-[var(--bdr)]" style="background:var(--bg-glass);">
            <ol class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-8 list-none p-0">
              {STEPS.map((s, i) => (
                <li class="flex gap-4">
                  <span class="flex-shrink-0 w-8 h-8 rounded-full flex items-center justify-center font-bold text-white text-sm bg-[var(--brand)]">{i + 1}</span>
                  <div>
                    <strong class="block mb-1 font-bold" style="color:var(--txt);">{s.step}</strong>
                    <p class="text-[0.85rem] opacity-60 leading-relaxed">{s.detail}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </div>
      )}

      <h2 class="text-3xl font-black mb-10 text-center" style="color:var(--txt);">{t['common.faq']}</h2>
      <div class="max-w-3xl mx-auto space-y-4 mb-20">
        {FAQS.map(faq => (
          <FAQItem q={faq.q} a={faq.a} />
        ))}
      </div>

      <TrendingDownloads />

      <TryOtherPlatforms current="pSeo" />
    </div>
  </section>
</PageLayout>
