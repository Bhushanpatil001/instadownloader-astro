---
import { SITE_URL } from '../data/constants.js';
import PageLayout from '../layouts/PageLayout.astro';
import DownloaderWidget from '../components/react/DownloaderWidget.jsx';
import FAQItem from '../components/FAQItem.astro';
import TrendingDownloads from '../components/TrendingDownloads.astro';
import TryOtherPlatforms from '../components/TryOtherPlatforms.astro';
import RichContent from '../components/RichContent.astro';

import { platforms, ui } from '../data/i18n.js';

const pData = platforms['pinterest']?.en || {};
const FAQS = pData.faqs || [];
const STEPS = pData.steps || [];
const t = ui.en;

const pinSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    '@id': `${SITE_URL}/pinterest#tool`,
    name: 'Pinterest Video Downloader — InstaDownloader',
    url: `${SITE_URL}/pinterest`,
    description: pData.desc || 'Free Pinterest video and image downloader. Download Pinterest videos, GIFs and photos in HD quality.',
    applicationCategory: 'MultimediaApplication',
    applicationSubCategory: 'Video Downloader',
    operatingSystem: 'Any (web-based)',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: { '@id': `${SITE_URL}/#organization` },
    featureList: [
      'HD video download',
      'Image and GIF download',
      'No login required',
      'Works on iOS, Android, Windows and macOS',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'How to download Pinterest videos with InstaDownloader',
    totalTime: 'PT30S',
    step: [
      { '@type': 'HowToStep', position: 1, name: 'Copy the Pin link', text: 'On Pinterest, tap the Share button and then Copy Link for any public Pin.' },
      { '@type': 'HowToStep', position: 2, name: 'Paste the URL', text: 'Paste the link into the search field on InstaDownloader and click the download button.' },
      { '@type': 'HowToStep', position: 3, name: 'Download in HD', text: 'Click the download button and the video or image saves to your device instantly.' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQS.map(faq => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
];
---

<PageLayout
  title={pData.title || "Pinterest Video Downloader — Download Pinterest Videos & Images HD Free 2026"}
  description={pData.desc || "Free Pinterest video and image downloader. Download Pinterest videos, GIFs and photos in HD quality. No login, no watermark, instant save. Works on all devices."}
  ogImage="/og-pinterest.png"
  schema={pinSchema}
>
  <div class="max-w-[1000px] mx-auto px-6 py-5">
    <div class="text-center mb-6">
      <h1 class="text-[clamp(1.8rem,4vw,2.8rem)] font-black mb-1 leading-tight" style="color:var(--txt);">
        {pData.h1 || "Pinterest Video Downloader"}
      </h1>
      <p class="text-lg opacity-70 max-w-[700px] mx-auto">
        Download videos and high-res images from Pinterest Pins — fast and free.
      </p>
    </div>

    <DownloaderWidget
      client:load
      platform="pin"
      apiEndpoint="/pinterest/download"
      placeholder="Paste Pinterest Pin URL here…"
    >
      <div class="seo-content-section mt-12">
        <h2 class="seo-section-heading">High-Quality Pinterest Media Downloader</h2>
        <p class="seo-p">
          Pinterest is the ultimate place for visual inspiration. Whether it's home decor, fashion trends, or DIY tutorials, our <strong>Pinterest downloader</strong> helps you preserve those ideas offline. 
        </p>
        <p class="seo-p">
          We handle both video and image Pins, fetching the highest quality available directly from Pinterest's servers. Our tool is fast, free, and works on any device without the need for additional apps.
        </p>

        <h2 class="seo-section-heading">How to Use the Pinterest Downloader</h2>
        <div class="p-8 rounded-[24px] border border-[var(--bdr)] mb-12" style="background:var(--bg-glass);">
          <ol class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-8 list-none p-0">
            {STEPS.map((s, i) => (
              <li class="flex gap-4">
                <span class="flex-shrink-0 w-8 h-8 rounded-full flex items-center justify-center font-bold text-white text-sm" style="background:#e60023">{i + 1}</span>
                <div>
                  <strong class="block mb-1 font-bold" style="color:var(--txt);">{s.step}</strong>
                  <p class="text-[0.85rem] opacity-60 leading-relaxed">{s.detail}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>

        <h2 class="seo-section-heading">Frequently Asked Questions — Pinterest</h2>
        <div class="max-w-[1000px] mx-auto space-y-3 mb-16">
          {FAQS.map(faq => <FAQItem q={faq.q} a={faq.a} />)}
        </div>
      </div>
    </DownloaderWidget>

    <RichContent
      platform="Pinterest"
      features={[
        { icon: '📌', title: 'Download Pinterest Videos', desc: 'Save any public Pinterest video Pin as a full-quality MP4 file — ideal for offline viewing, presentations, or reference.' },
        { icon: '🖼️', title: 'Download Pinterest Images', desc: 'Save original-resolution photos from any public Pinterest Pin as a JPG or PNG file directly to your device.' },
        { icon: '🎉', title: 'Download Pinterest GIFs', desc: 'Animated GIF Pins can be saved as GIF files, preserving the animation loop exactly as it appears on Pinterest.' },
        { icon: '🔒', title: 'No Pinterest Login', desc: 'No account required. Paste any public Pin link and download the content — no Pinterest credentials ever needed.' },
        { icon: '⚡', title: 'Fast & Simple', desc: 'Three steps: copy the Pin link, paste it into InstaDownloader, and click download. Takes under 10 seconds.' },
        { icon: '🆓', title: 'Unlimited Downloads', desc: 'No cap on downloads. Save as many Pinterest Pins, videos, and images as you need, every day.' },
      ]}
      supportedTypes={[
        { label: 'Pinterest Video Pins (MP4)', desc: 'Videos posted directly to Pinterest or embedded as native video Pins. Saved as MP4 in the highest resolution available on the platform.' },
        { label: 'Pinterest Photo Pins (JPG/PNG)', desc: 'Original high-resolution photos attached to any public Pin. Quality matches what the creator originally uploaded — no compression added by InstaDownloader.' },
        { label: 'Pinterest GIF Pins', desc: 'Animated GIFs posted as Pins. Saved as standard .gif files that play in any image viewer or browser.' },
        { label: 'Story Pins / Idea Pins', desc: 'Pinterest’s Idea Pin format (multi-slide visual stories) — downloadable as individual images or video where the format supports it.' },
        { label: 'Board Preview Images', desc: 'Individual Pin images from collections and boards, downloaded in original resolution for moodboards and creative reference.' },
      ]}
      whySection={{
        title: 'Why Use InstaDownloader for Pinterest?',
        paras: [
          'Pinterest is a visual discovery platform used by hundreds of millions of people to find inspiration for interior design, fashion, recipes, travel, art, and countless other topics. While Pinterest allows you to save Pins to boards within the app, it does not offer a direct download button to save images or videos to your device. <strong>InstaDownloader bridges this gap</strong> — giving you the actual file, not just a bookmark.',
          'For designers, photographers, architects, stylists, and creative professionals, being able to save high-resolution reference images from Pinterest is essential. InstaDownloader downloads the original uploaded resolution — not a compressed thumbnail — so your reference material retains its full detail.',
          'Pinterest video Pins are increasingly popular for recipes, DIY tutorials, home renovation reveals, and fashion lookbooks. Our tool handles all Pinterest video formats and saves them as clean MP4 files playable on any device, video editor, or media player.',
          'Pinterest GIF Pins are a staple of decorating boards, mood boards, and creative inspiration collections. InstaDownloader saves these as genuine .gif files rather than converting them to a lossy video format, so the animation quality and loop behaviour are perfectly preserved.',
          'InstaDownloader accepts every Pinterest URL format: standard pin links (pinterest.com/pin/...), short links (pin.it/...), and direct image URLs shared from the Pinterest app on mobile. Whatever you copy from Pinterest, our tool will handle it.',
        ],
      }}
      proTips={[
        { tip: 'Copy the Pin URL from the address bar', detail: 'On desktop, the cleanest URL is in the browser address bar when you open a specific Pin page. It looks like pinterest.com/pin/1234567890.' },
        { tip: 'Use the Share button on mobile', detail: 'In the Pinterest app, tap the three-dot menu (⋯) on any Pin and select “Copy link”. The resulting short URL (pin.it/...) works perfectly with InstaDownloader.' },
        { tip: 'Download Idea Pins early', detail: 'Idea Pins (formerly Story Pins) can be removed by creators at any time. If you want to save one for reference, do it soon after finding it.' },
        { tip: 'Board overview images vs individual Pins', detail: 'To download a specific image, open the individual Pin page — not the board overview. Individual Pin pages give you the original-resolution file.' },
        { tip: 'Pinterest images may be copyrighted', detail: 'Many images on Pinterest are owned by photographers, designers, or brands. Always check usage rights before using downloaded images in your own commercial work.' },
      ]}
      disclaimer="InstaDownloader is an independent tool not affiliated with, endorsed by, or connected to Pinterest, Inc. Download only content you have the right to use. Many images and videos on Pinterest are protected by copyright. Using downloaded Pinterest content commercially without the copyright holder’s permission may violate Pinterest’s Terms of Service and applicable intellectual property laws."
    />

    <div class="mt-16 pt-16 border-t border-[var(--bdr)]">
      <TrendingDownloads />
    </div>

    <div class="mt-12">
       <TryOtherPlatforms current="pinterest" />
    </div>
  </div>
</PageLayout>
