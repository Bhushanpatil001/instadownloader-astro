---
export const prerender = true;
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout
  title="404 - Page Not Found | InstaDownloader"
  description="Page Not Found. Return to the home page or choose one of our free downloader tools."
>
  <div class="min-h-[75vh] flex flex-col items-center justify-center px-6 py-12 relative overflow-hidden">
    
    <!-- Background glowing auras -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[300px] h-[300px] rounded-full bg-[var(--brand)] opacity-10 blur-[100px] pointer-events-none"></div>
    <div class="absolute bottom-1/4 left-1/3 w-[200px] h-[200px] rounded-full bg-[var(--accent)] opacity-10 blur-[90px] pointer-events-none"></div>

    <div class="max-w-[720px] w-full text-center relative z-10">
      
      <!-- Premium 404 Header with Bounce Animation -->
      <div class="relative inline-block mb-4 select-none animate-bounce-subtle">
        <h1 class="text-[clamp(6rem,14vw,10rem)] font-black leading-none tracking-tighter" 
            style="background: var(--g-brand); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; filter: drop-shadow(0 10px 30px rgba(124, 58, 237, 0.3));">
          404
        </h1>
        <div class="absolute -inset-4 bg-gradient-to-r from-[var(--brand)] to-[var(--accent)] opacity-5 blur-2xl rounded-full pointer-events-none"></div>
      </div>

      <!-- Main Heading -->
      <h2 class="text-[clamp(1.5rem,4vw,2.5rem)] font-black mb-10 tracking-tight leading-none" style="color:var(--txt);">
        Page Not Found !
      </h2>

      <!-- CTA Buttons with Micro-Animations -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 max-w-[480px] mx-auto">
        <a href="/" 
           class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-2xl text-white font-bold text-base transition-all duration-300 hover:-translate-y-1 active:scale-95 shadow-lg hover:shadow-xl hover:shadow-[rgba(124,58,237,0.3)] hover:opacity-95" 
           style="background: var(--g-brand); box-shadow: 0 10px 25px -5px rgba(124,58,237,0.45);">
          <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 mr-2">
            <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
          </svg>
          Go to Homepage
        </a>
        <button 
           onclick="window.history.length > 1 ? window.history.back() : window.location.href = '/'" 
           class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-2xl font-bold text-base border border-[var(--bdr)] transition-all duration-300 hover:bg-[var(--bg-glass-h)] hover:text-[var(--txt)] hover:border-[var(--bdr-h)] active:scale-95"
           style="background: var(--bg-glass); color: var(--txt2);">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 mr-2">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          Go Back
        </button>
      </div>

    </div>
  </div>
</PageLayout>

<style>
  @keyframes bounce-subtle {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }
  .animate-bounce-subtle {
    animation: bounce-subtle 4s ease-in-out infinite;
  }
</style>

