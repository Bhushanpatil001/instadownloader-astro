---
import { SITE_URL } from '../data/constants.js';
import PageLayout from '../layouts/PageLayout.astro';
import DownloaderWidget from '../components/react/DownloaderWidget.jsx';
import TryOtherPlatforms from '../components/TryOtherPlatforms.astro';
import FAQItem from '../components/FAQItem.astro';
import PlatformIcon from '../components/PlatformIcon.astro';
import TrendingDownloads from '../components/TrendingDownloads.astro';

import { platforms, ui } from '../data/i18n.js';

const pData = platforms['instagram-reels-downloader']?.en || {};
const FAQS = pData.faqs || [];
const STEPS = pData.steps || [];
const t = ui.en;

const reelsSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Instagram Reels Downloader — InstaDownloader',
    url: `${SITE_URL}/instagram-reels-downloader`,
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    alternateName: [
      'instagram reels downloader', 'download instagram reels',
      'reels downloader', 'ig reels downloader',
      'instagram reel saver', 'download reels from instagram',
      'save instagram reels', 'instagram reels video downloader',
      'download ig reels', 'instagram reels mp4 downloader',
      'instagram reels downloader without watermark',
      'download instagram reels without login',
    ],
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: '4.9',
      ratingCount: '3760',
      bestRating: '5',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQS.map(faq => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
];
---

<PageLayout
  title={pData.title || "Instagram Reels Downloader — Download IG Reels HD Free, No Watermark 2026"}
  description={pData.desc || "Download Instagram Reels for free in HD without watermark. Paste any Reel link and save it instantly as MP4. Works on iPhone, Android & PC. No login required."}
  keywords="instagram reels downloader, download instagram reels, reels downloader, ig reels downloader, save instagram reels, download reels from instagram, instagram reels video downloader, instagram reels mp4 downloader, instagram reels downloader without watermark, download instagram reels without login, instagram reel saver"
  schema={reelsSchema}
>
  <section class="max-w-[860px] mx-auto px-5 pt-12 pb-16">
    <div class="text-center mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-[0.75rem] font-bold uppercase tracking-wider mb-4"
        style="background:rgba(225,48,108,0.12); border:1px solid rgba(225,48,108,0.3); color:#e1306c;">
        <PlatformIcon platform="instagram" size={14} />
        <span>REELS EXCLUSIVE</span>
      </div>
      <h1 class="text-[2.2rem] font-black mb-3" style="color:var(--txt);">
        {pData.h1 || "Instagram Reels Downloader"}
      </h1>
      <p class="text-[1rem]" style="color:var(--txt2);">
        High-quality Instagram Reels video downloader.
      </p>
    </div>

    <DownloaderWidget
      client:load
      platform="ig"
      apiEndpoint="/instagram/download"
      placeholder="Paste Instagram Reel link here..."
    />

    <div class="mt-16 prose prose-invert max-w-none border-t border-[var(--bdr)] pt-16">
      <h2 class="text-[1.5rem] font-bold mb-6 text-center" style="color:var(--txt);">Save Instagram Reels in High Resolution</h2>
      <p class="text-[0.95rem] leading-relaxed mb-10 text-center opacity-70 max-w-[700px] mx-auto">
        Reels are the heart of Instagram creativity. Our tool ensures you can preserve these moments in their original resolution, without any added watermarks or quality loss.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-16">
        <div class="p-8 rounded-[24px] border border-[var(--bdr)]" style="background:var(--bg-glass);">
          <h3 class="text-[1.1rem] font-bold mb-2">🎬 Best Quality MP4</h3>
          <p class="text-[0.85rem]" style="color:var(--txt3);">Get the original file exactly as it was uploaded to Instagram's servers.</p>
        </div>
        <div class="p-8 rounded-[24px] border border-[var(--bdr)]" style="background:var(--bg-glass);">
          <h3 class="text-[1.1rem] font-bold mb-2">🔒 Secure & Private</h3>
          <p class="text-[0.85rem]" style="color:var(--txt3);">No data logging or tracking. Your downloads are private and secure.</p>
        </div>
      </div>

      {STEPS.length > 0 && (
        <div class="mb-20">
          <h2 class="text-[1.5rem] font-bold mb-8 text-center" style="color:var(--txt);">{t['common.how_to'] || "How to Use"}</h2>
          <div class="p-8 rounded-[24px] border border-[var(--bdr)]" style="background:var(--bg-glass);">
            <ol class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-8 list-none p-0">
              {STEPS.map((s, i) => (
                <li class="flex gap-4">
                  <span class="flex-shrink-0 w-8 h-8 rounded-full flex items-center justify-center font-bold text-white text-sm bg-[var(--brand)]">{i + 1}</span>
                  <div>
                    <strong class="block mb-1 font-bold" style="color:var(--txt);">{s.step}</strong>
                    <p class="text-[0.85rem] opacity-60 leading-relaxed">{s.detail}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </div>
      )}

      <h2 class="text-[1.5rem] font-bold mb-8 text-center" style="color:var(--txt);">Frequently Asked Questions</h2>
      <div class="max-w-[800px] mx-auto space-y-4 mb-20">
        {FAQS.map(faq => (
          <FAQItem q={faq.q} a={faq.a} />
        ))}
      </div>

      <TrendingDownloads />
    </div>

    <div class="mt-12">
      <TryOtherPlatforms current="ig" />
    </div>
  </section>
</PageLayout>
