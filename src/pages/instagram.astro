---
import { SITE_URL } from '../data/constants.js';
import PageLayout from '../layouts/PageLayout.astro';
import DownloaderWidget from '../components/react/DownloaderWidget.jsx';
import FAQItem from '../components/FAQItem.astro';
import TrendingDownloads from '../components/TrendingDownloads.astro';
import TryOtherPlatforms from '../components/TryOtherPlatforms.astro';

import { platforms, ui } from '../data/i18n.js';

const pData = platforms['instagram']?.en || {};
const FAQS = pData.faqs || [];
const STEPS = pData.steps || [];
const t = ui.en;

const igSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Instagram Downloader — InstaDownloader',
    url: `${SITE_URL}/instagram`,
    description: pData.desc || 'Free Instagram video downloader. Download Instagram reels, posts, stories, IGTV and photos in HD. No login, no watermark, instant save.',
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'Any',
    browserRequirements: 'Requires JavaScript. Requires HTML5.',
    image: `${SITE_URL}/og-image.png`,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: {
      '@type': 'Organization',
      name: 'InstaDownloader',
      logo: {
        '@type': 'ImageObject',
        url: `${SITE_URL}/favicon.ico`
      }
    },
    alternateName: [
      'instagram downloader', 'instadownloader', 'insta downloader',
      'igram', 'igram.io', 'instagram video downloader',
      'instagram reels downloader', 'instagram photo downloader',
      'instagram story downloader', 'insta video downloader',
      'save instagram videos', 'download instagram reels',
      'instagram saver', 'ig downloader', 'ig video downloader',
      'download instagram photos', 'instagram story saver',
      'download instagram without watermark',
    ],
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: '4.9',
      ratingCount: '5230',
      bestRating: '5',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQS.map(faq => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
];
---

<PageLayout
  title={pData.title || "Instagram Video Downloader — Download Reels, Posts, Stories & IGTV Free 2026"}
  description={pData.desc || "Free Instagram video downloader. Download Instagram reels, posts, stories, IGTV and photos in HD. No login, no watermark, instant save. Works on Android, iPhone & PC."}
  keywords="instagram downloader, instadownloader, insta downloader, igram, instagram video downloader, instagram reels downloader, instagram photo downloader, instagram story downloader, download instagram reels, ig downloader, instagram saver, save instagram videos, download instagram videos free, instagram story saver, instagram video saver, reels downloader, download instagram without login"
  schema={igSchema}
>
  <div class="max-w-[1000px] mx-auto px-6 py-5">
    <div class="text-center mb-6">
      <div class="inline-flex px-4 py-1.5 rounded-full text-sm font-bold bg-[rgba(225,48,108,0.1)] border border-[rgba(225,48,108,0.2)] text-[#e1306c] mb-3">📸 Insta Saver</div>
      <h1 class="text-[clamp(1.8rem,4vw,2.8rem)] font-black mb-1 leading-tight" style="color:var(--txt);">
        {pData.h1 || "Instagram Video Downloader"}
      </h1>
      <p class="text-lg opacity-70 max-w-[700px] mx-auto">
        Download posts, reels, IGTV, and stories from Instagram — fast and free, no login needed.
      </p>
    </div>

    <DownloaderWidget
      client:load
      platform="ig"
      apiEndpoint="/instagram/download"
      placeholder="Paste Instagram URL here (post, reel, story…)"
    >
      <div class="seo-content-section mt-12">
        <h2 class="seo-section-heading">All-in-One Instagram Content Downloader</h2>
        <p class="seo-p">
          Instagram is where the world's most creative photos and videos live. Whether you're following a travel influencer, a gourmet chef, or a digital artist, our <strong>Instagram downloader</strong> helps you save that inspiration directly to your phone or computer.
        </p>
        <p class="seo-p">
          We support all public content types: standard feed posts (photos & videos), high-energy Reels, long-form IGTV clips, and even temporary Stories. Everything is served in high definition with a single click.
        </p>

        <h2 class="seo-section-heading">How to Use the Instagram Downloader</h2>
        <div class="p-8 rounded-[24px] border border-[var(--bdr)] mb-12" style="background:var(--bg-glass);">
          <ol class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-8 list-none p-0">
            {STEPS.map((s, i) => (
              <li class="flex gap-4">
                <span class="flex-shrink-0 w-8 h-8 rounded-full flex items-center justify-center font-bold text-white text-sm" style="background:linear-gradient(135deg,#f09433,#dc2743)">{i + 1}</span>
                <div>
                  <strong class="block mb-1 font-bold" style="color:var(--txt);">{s.step}</strong>
                  <p class="text-[0.85rem] opacity-60 leading-relaxed">{s.detail}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>

        <h2 class="seo-section-heading">Frequently Asked Questions — Instagram</h2>
        <div class="max-w-[1000px] mx-auto space-y-3 mb-16">
          {FAQS.map(faq => <FAQItem q={faq.q} a={faq.a} />)}
        </div>
      </div>
    </DownloaderWidget>

    <div class="mt-16 pt-16 border-t border-[var(--bdr)]">
      <TrendingDownloads />
    </div>

    <div class="mt-12">
       <TryOtherPlatforms current="instagram" />
    </div>
  </div>
</PageLayout>
