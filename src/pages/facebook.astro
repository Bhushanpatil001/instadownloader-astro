---
import { SITE_URL } from '../data/constants.js';
import PageLayout from '../layouts/PageLayout.astro';
import DownloaderWidget from '../components/react/DownloaderWidget.jsx';
import FAQItem from '../components/FAQItem.astro';
import TrendingDownloads from '../components/TrendingDownloads.astro';
import TryOtherPlatforms from '../components/TryOtherPlatforms.astro';
import RichContent from '../components/RichContent.astro';

import { platforms, ui } from '../data/i18n.js';

const pData = platforms['facebook']?.en || {};
const FAQS = pData.faqs || [];
const STEPS = pData.steps || [];
const t = ui.en;

const fbSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    '@id': `${SITE_URL}/facebook#tool`,
    name: 'Facebook Video Downloader — InstaDownloader',
    url: `${SITE_URL}/facebook`,
    description: pData.desc || 'Free Facebook video downloader. Download Facebook videos, reels and stories in HD. No login required.',
    applicationCategory: 'MultimediaApplication',
    applicationSubCategory: 'Video Downloader',
    operatingSystem: 'Any (web-based)',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: { '@id': `${SITE_URL}/#organization` },
    featureList: [
      'HD video download',
      'No login required',
      'Download Facebook Videos, Reels and Stories',
      'Works on iOS, Android, Windows and macOS',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'How to download Facebook videos with InstaDownloader',
    totalTime: 'PT30S',
    step: [
      { '@type': 'HowToStep', position: 1, name: 'Copy the link', text: 'On Facebook, tap Share and then Copy Link for any public post or video.' },
      { '@type': 'HowToStep', position: 2, name: 'Paste the URL', text: 'Paste the link into the search field on InstaDownloader and click the download button.' },
      { '@type': 'HowToStep', position: 3, name: 'Download in HD', text: 'Click the download button and the file saves to your device instantly.' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQS.map(faq => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
];
---

<PageLayout
  title={pData.title || "Facebook Video Downloader — Download FB Reels & Videos in HD Free 2026"}
  description={pData.desc || "Free Facebook video downloader. Download Facebook videos, reels and stories in HD. No login required. Fast & secure. Save FB videos to your phone or PC instantly."}
  ogImage="/og-facebook.png"
  schema={fbSchema}
>
  <div class="max-w-[1000px] mx-auto px-6 py-5">
    <div class="text-center mb-6">
      <h1 class="text-[clamp(1.8rem,4vw,2.8rem)] font-black mb-1 leading-tight" style="color:var(--txt);">
        {pData.h1 || "Facebook Video Downloader"}
      </h1>
      <p class="text-lg opacity-70 max-w-[700px] mx-auto">
        Download videos and reels from Facebook posts and pages — fast and free, no login needed.
      </p>
    </div>

    <DownloaderWidget
      client:load
      platform="fb"
      apiEndpoint="/facebook/download"
      placeholder="Paste Facebook video or reel URL here…"
    >
      <div class="seo-content-section mt-12">
        <h2 class="seo-section-heading">Download High-Quality Facebook Videos & Reels</h2>
        <p class="seo-p">
          Facebook is home to millions of viral videos, informative clips, and entertaining reels. Our <strong>Facebook downloader</strong> makes it incredibly simple to save any public video directly to your smartphone, tablet, or PC in high definition.
        </p>
        <p class="seo-p">
          Whether it's a cooking tutorial, a news segment, or a funny reel from your feed, you can save it for offline viewing without any watermark and in the best possible resolution.
        </p>

        <h2 class="seo-section-heading">How to Use the Facebook Downloader</h2>
        <div class="p-8 rounded-[24px] border border-[var(--bdr)] mb-12" style="background:var(--bg-glass);">
          <ol class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-8 list-none p-0">
            {STEPS.map((s, i) => (
              <li class="flex gap-4">
                <span class="flex-shrink-0 w-8 h-8 rounded-full flex items-center justify-center font-bold text-white text-sm" style="background:#1877f2">{i + 1}</span>
                <div>
                  <strong class="block mb-1 font-bold" style="color:var(--txt);">{s.step}</strong>
                  <p class="text-[0.85rem] opacity-60 leading-relaxed">{s.detail}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>

        <h2 class="seo-section-heading">Frequently Asked Questions — Facebook</h2>
        <div class="max-w-[1000px] mx-auto space-y-3 mb-16">
          {FAQS.map(faq => <FAQItem q={faq.q} a={faq.a} />)}
        </div>
      </div>
    </DownloaderWidget>

    <RichContent
      platform="Facebook"
      features={[
        { icon: '🎬', title: 'HD Video Download', desc: 'Save any public Facebook video in HD or SD quality as an MP4 file playable on any device.' },
        { icon: '🔄', title: 'Download Facebook Reels', desc: 'Facebook Reels are short vertical videos. InstaDownloader saves them as clean MP4 files in original quality.' },
        { icon: '📸', title: 'Story Videos', desc: 'Download video stories from public Facebook profiles and pages before they expire after 24 hours.' },
        { icon: '🔒', title: 'No Facebook Login', desc: 'No need to connect your Facebook account. Paste any public video link and download instantly.' },
        { icon: '🆓', title: 'Unlimited & Free', desc: 'No daily limits, no subscription fees. Download as many Facebook videos as you need every day.' },
        { icon: '🌐', title: 'Works on All Devices', desc: 'Use InstaDownloader in any browser on iOS, Android, Windows or macOS.' },
      ]}
      supportedTypes={[
        { label: 'Public Facebook Videos (MP4)', desc: 'Standard videos posted to any public Facebook profile, page, or group. Downloaded as MP4 in the highest available quality.' },
        { label: 'Facebook Reels', desc: 'Short-form vertical videos in the Reels section of Facebook. Saved as a standard MP4 without any overlay watermark.' },
        { label: 'Facebook Watch Videos', desc: 'Videos from the Facebook Watch section, including show clips, news videos, and creator content from public pages.' },
        { label: 'Video Stories', desc: 'Public Facebook video stories, saved before they disappear at the 24-hour mark.' },
        { label: 'Live Replay Videos', desc: 'Recorded Facebook Live sessions that have been made public on a profile or page can be downloaded after the broadcast ends.' },
      ]}
      whySection={{
        title: 'Why Use InstaDownloader for Facebook?',
        paras: [
          'Facebook remains one of the most widely used social media platforms globally, with billions of active users sharing videos daily across profiles, groups, pages, and the Watch section. While Facebook has an internal save feature, it only bookmarks videos inside the app — it does not let you download them as files to your device. <strong>InstaDownloader solves this</strong> with a simple paste-and-download approach.',
          'Our Facebook video downloader works for any publicly accessible video. This includes standard feed videos, Facebook Reels, Watch content, and even replays of Facebook Live sessions that have been made publicly available. Simply open the video on Facebook, copy its link from the share menu or address bar, paste it into InstaDownloader, and download.',
          'Quality selection matters. Our tool offers both HD and SD download options for Facebook videos. If storage space is a concern, SD delivers a smaller file. If you want the best possible quality for editing or archiving, HD delivers the original stream resolution that Facebook stores.',
          'Privacy and security are handled with care. InstaDownloader does not require you to log in with your Facebook credentials, and we never store the URLs you submit. All processing happens in real-time. We act purely as a gateway — your request, Facebook’s CDN, your device.',
          'InstaDownloader is particularly useful for journalists, social media managers, researchers, and content archivists who routinely need to download and preserve public video content from Facebook for professional purposes.',
        ],
      }}
      proTips={[
        { tip: 'Copy the video link from the share menu', detail: 'On Facebook, click the three-dot menu (⋯) on a video post and select “Copy link”. This gives the cleanest URL our tool processes.' },
        { tip: 'For Facebook Watch videos, copy the URL from the address bar', detail: 'Facebook Watch videos often have URLs in the format facebook.com/watch?v=... — copy this from your browser’s address bar on desktop.' },
        { tip: 'Group videos require the group to be public', detail: 'Videos in private Facebook groups are not accessible externally. Only videos in public groups or on public profiles and pages can be downloaded.' },
        { tip: 'Right-click the m.facebook.com version on mobile', detail: 'On mobile browsers, switching to m.facebook.com instead of www.facebook.com often gives simpler URLs that resolve faster with our tool.' },
        { tip: 'Choose HD for archive quality', detail: 'If you are archiving footage for professional use, always select the HD option. Facebook compresses SD video significantly during upload processing.' },
      ]}
      disclaimer="InstaDownloader is an independent tool not affiliated with, endorsed by, or connected to Facebook or Meta Platforms, Inc. Download only content you have the right to use. Downloading and redistributing copyrighted Facebook content without the owner’s permission may violate Meta’s Terms of Service and applicable copyright laws."
    />

    <div class="mt-16 pt-16 border-t border-[var(--bdr)]">
      <TrendingDownloads />
    </div>

    <div class="mt-12">
       <TryOtherPlatforms current="facebook" />
    </div>
  </div>
</PageLayout>
