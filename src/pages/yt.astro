---
import { SITE_URL } from '../data/constants.js';
import PageLayout from '../layouts/PageLayout.astro';
import DownloaderWidget from '../components/react/DownloaderWidget.jsx';
import FAQItem from '../components/FAQItem.astro';
import TrendingDownloads from '../components/TrendingDownloads.astro';
import TryOtherPlatforms from '../components/TryOtherPlatforms.astro';
import RichContent from '../components/RichContent.astro';

import { platforms, ui } from '../data/i18n.js';

const pData = platforms['yt']?.en || {};
const FAQS = pData.faqs || [];
const STEPS = pData.steps || [];
const t = ui.en;

const ytSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    '@id': `${SITE_URL}/yt#tool`,
    name: 'YouTube Video Downloader — InstaDownloader',
    url: `${SITE_URL}/yt`,
    description: pData.desc || 'Free YouTube video downloader. Download YouTube videos in HD, convert to MP3, save YouTube Shorts.',
    applicationCategory: 'MultimediaApplication',
    applicationSubCategory: 'Video Downloader',
    operatingSystem: 'Any (web-based)',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: { '@id': `${SITE_URL}/#organization` },
    featureList: [
      'HD video download',
      'MP3 audio extraction',
      'YouTube Shorts support',
      'Works on iOS, Android, Windows and macOS',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'How to download YouTube videos with InstaDownloader',
    totalTime: 'PT30S',
    step: [
      { '@type': 'HowToStep', position: 1, name: 'Copy the link', text: 'On YouTube, tap Share and then Copy Link for any public video or Short.' },
      { '@type': 'HowToStep', position: 2, name: 'Paste the URL', text: 'Paste the link into the search field on InstaDownloader and click the download button.' },
      { '@type': 'HowToStep', position: 3, name: 'Download in HD', text: 'Choose your preferred format (MP4 or MP3) and the file saves to your device instantly.' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQS.map(faq => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
];
---

<PageLayout
  title={pData.title || "YouTube Video Downloader — Download Videos, Shorts & MP3 from YouTube Free 2026"}
  description={pData.desc || "Free YouTube video downloader. Download YouTube videos in HD, convert YouTube to MP3, save YouTube Shorts. Fast, secure, no registration. Works on mobile & desktop."}
  ogImage="/og-youtube.png"
  schema={ytSchema}
>
  <div class="max-w-[1000px] mx-auto px-6 py-5">
    <div class="text-center mb-6">
      <h1 class="text-[clamp(1.8rem,4vw,2.8rem)] font-black mb-1 leading-tight" style="color:var(--txt);">
        {pData.h1 || "YouTube Video Downloader"}
      </h1>
      <p class="text-lg opacity-70 max-w-[700px] mx-auto">
        Download videos, shorts, and extract MP3 audio from YouTube — fast and free.
      </p>
    </div>

    <DownloaderWidget
      client:load
      platform="yt"
      apiEndpoint="/youtube/download"
      placeholder="Paste YouTube or Shorts URL here…"
    >
      <div class="seo-content-section mt-12">
        <h2 class="seo-section-heading">High-Speed YouTube Video & MP3 Downloader</h2>
        <p class="seo-p">
          YouTube is the largest video library on the planet. Whether you're looking for educational tutorials, music videos, or the latest tech reviews, our <strong>YouTube downloader</strong> is the fastest way to save content for offline use.
        </p>
        <p class="seo-p">
          We offer flexible download options, including high-definition MP4 videos and high-bitrate MP3 audio extraction. Our tool is optimized for 2026, ensuring compatible downloads for all modern smartphones and computers.
        </p>

        <h2 class="seo-section-heading">How to Use the YouTube Downloader</h2>
        <div class="p-8 rounded-[24px] border border-[var(--bdr)] mb-12" style="background:var(--bg-glass);">
          <ol class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-8 list-none p-0">
            {STEPS.map((s, i) => (
              <li class="flex gap-4">
                <span class="flex-shrink-0 w-8 h-8 rounded-full flex items-center justify-center font-bold text-white text-sm" style="background:#ff0000">{i + 1}</span>
                <div>
                  <strong class="block mb-1 font-bold" style="color:var(--txt);">{s.step}</strong>
                  <p class="text-[0.85rem] opacity-60 leading-relaxed">{s.detail}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>

        <h2 class="seo-section-heading">Frequently Asked Questions — YouTube</h2>
        <div class="max-w-[1000px] mx-auto space-y-3 mb-16">
          {FAQS.map(faq => <FAQItem q={faq.q} a={faq.a} />)}
        </div>
      </div>
    </DownloaderWidget>

    <RichContent
      platform="YouTube"
      features={[
        { icon: '🎬', title: 'HD Video Download', desc: 'Download any public YouTube video in HD quality up to 1080p as a standard MP4 file ready for any device or video editor.' },
        { icon: '🎵', title: 'YouTube to MP3', desc: 'Extract the audio track from any YouTube video and save it as a high-quality MP3 file — perfect for music, podcasts, and lectures.' },
        { icon: '📱', title: 'YouTube Shorts Download', desc: 'Save vertical YouTube Shorts as MP4. Works the same as regular videos — just paste the Shorts URL and download instantly.' },
        { icon: '🚀', title: 'No Software Install', desc: 'A fully web-based tool. Works in Chrome, Safari, Firefox and Edge on any operating system — no extensions or apps needed.' },
        { icon: '🆓', title: 'Always Free', desc: 'No paywalls. Download as many YouTube videos as you need every day at no cost. No subscription required.' },
        { icon: '🔒', title: 'No YouTube Login', desc: 'You never need to connect your Google or YouTube account. Paste the link and download — that is all.' },
      ]}
      supportedTypes={[
        { label: 'YouTube Videos (MP4, up to 1080p)', desc: 'Standard YouTube videos in full HD quality. The file downloads as an MP4 which plays on every device, TV, and video editing application.' },
        { label: 'YouTube Audio (MP3)', desc: 'The audio-only track from any YouTube video. Ideal for podcasts, music, interviews, lectures, and audiobooks.' },
        { label: 'YouTube Shorts (MP4)', desc: 'Short-form vertical videos (up to 60 seconds). Saved as a standard MP4 at up to 1080×1920 resolution.' },
        { label: 'Playlists (individual videos)', desc: 'Paste the URL of any individual video within a playlist to download that specific video quickly.' },
        { label: 'Unlisted Videos', desc: 'Any YouTube video with an accessible URL — including unlisted videos — can be downloaded as long as the link is shareable.' },
      ]}
      whySection={{
        title: 'Why Use InstaDownloader for YouTube?',
        paras: [
          'YouTube is the world\'s largest video platform, hosting billions of videos spanning every topic imaginable — from educational lectures and tutorials to music videos and live sporting events. While YouTube Premium subscribers get an official offline mode inside the YouTube app, most users have no built-in way to save videos to their device for later viewing. <strong>InstaDownloader\'s YouTube downloader</strong> fills that gap completely free of charge.',
          'Our tool works by reading the publicly accessible stream URLs that YouTube makes available for each video. When you paste a video link, our engine identifies the highest-quality format available and generates a direct download link to your browser — nothing is stored on our servers in between.',
          'One of the most popular features is our <strong>YouTube to MP3</strong> converter. Content creators, students, commuters, and music lovers use it daily to extract just the audio track from a video — whether that is a favourite song, a podcast episode, an audiobook, or a university lecture. The output is a clean, properly tagged MP3 file.',
          'YouTube Shorts has grown into one of the most watched short-form video formats globally. Our downloader handles Shorts URLs natively — just paste a Shorts link and it saves as a vertical MP4, identical to what you would find in the YouTube app.',
          'Because InstaDownloader is entirely web-based, there is nothing to install. It runs in your browser on iOS, Android, Windows, macOS, and Linux. You do not need a Google account, a YouTube account, or any plugin to use it.',
        ],
      }}
      proTips={[
        { tip: 'Copy the URL from the browser address bar', detail: 'On desktop, the cleanest YouTube URL is in the address bar (e.g. youtube.com/watch?v=...). Avoid using short links from share buttons as they sometimes redirect.' },
        { tip: 'Choose MP3 for audio-only content', detail: 'If you only want to listen — not watch — select the MP3 option after pasting the link. The file will be considerably smaller and plays on every music player.' },
        { tip: 'For Shorts, use the Shorts URL directly', detail: 'Shorts have a different URL format (youtube.com/shorts/...). Paste that URL directly for the best results.' },
        { tip: 'Age-restricted videos are not supported', detail: 'YouTube age-restricted videos require a logged-in session to access the stream. Since we do not connect to your account, these videos cannot be downloaded.' },
        { tip: 'Private videos cannot be downloaded', detail: 'Only public or unlisted YouTube videos with an accessible link can be downloaded. Private videos are protected and inaccessible externally.' },
      ]}
      disclaimer="InstaDownloader is an independent tool not affiliated with, endorsed by, or connected to YouTube or Google LLC. Download only content you have the right to use. Downloading copyrighted material without authorisation may violate YouTube's Terms of Service and applicable copyright law. This tool is intended for personal, non-commercial use only."
    />

    <div class="mt-16 pt-16 border-t border-[var(--bdr)]">
      <TrendingDownloads />
    </div>

    <div class="mt-12">
       <TryOtherPlatforms current="youtube" />
    </div>
  </div>
</PageLayout>
