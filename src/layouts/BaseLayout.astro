---
import { languages } from '../data/i18n.js';

interface Props {
  title: string;
  description: string;
  keywords?: string;
  canonical?: string;
  ogImage?: string;
  ogLocale?: string;
  schema?: object | object[];
}

const {
  title,
  description,
  keywords,
  canonical: propCanonical,
  ogImage = '/og-image.png',
  ogLocale = 'en_US',
  schema,
} = Astro.props;

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://instadownloader.app';

// Auto-generate hreflangs and canonical
const url = new URL(Astro.url.href);
const pathParts = url.pathname.split('/').filter(Boolean);
let currentLang = 'en';
let purePath = url.pathname;

if (pathParts.length > 0 && languages[pathParts[0]]) {
  currentLang = pathParts[0];
  purePath = '/' + pathParts.slice(1).join('/');
}

// Ensure canonical always uses the production domain
const canonical = propCanonical || `${siteUrl}${url.pathname}`;

const hreflangs = Object.keys(languages).map(l => ({
  lang: l,
  url: l === 'en' ? `${siteUrl}${purePath}` : `${siteUrl}/${l}${purePath}`
}));

const currentLocale = languages[currentLang]?.locale || 'en_US';

const SERVE_ADS = import.meta.env.PUBLIC_SERVE_ADS === 'true';
const AD_CLIENT  = 'ca-pub-2219975169694529';

const isHomePage = purePath === '/' || purePath === '';

// Default Organisation + WebSite schema injected ONLY on home page
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'InstaDownloader',
  url: siteUrl,
  logo: `${siteUrl}/favicon.ico`,
  sameAs: [],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'InstaDownloader',
  url: siteUrl,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteUrl}/?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};

// Dynamic BreadcrumbList generation
const breadcrumbItems = [];
const pathSegments = url.pathname.split('/').filter(Boolean);

let relativePathSegments = [...pathSegments];
let isLangPrefix = false;
if (pathSegments.length > 0 && languages[pathSegments[0]]) {
  relativePathSegments.shift();
  isLangPrefix = true;
}

if (relativePathSegments.length > 0) {
  breadcrumbItems.push({
    '@type': 'ListItem',
    position: 1,
    name: 'Home',
    item: isLangPrefix ? `${siteUrl}/${pathSegments[0]}` : siteUrl,
  });

  let currentPath = isLangPrefix ? `/${pathSegments[0]}` : '';
  relativePathSegments.forEach((segment, index) => {
    currentPath += `/${segment}`;
    let name = segment.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
    
    if (segment === 'yt') name = 'YouTube Downloader';
    else if (segment === 'instagram') name = 'Instagram Downloader';
    else if (segment === 'instagram-reels-downloader') name = 'Instagram Reels Downloader';
    else if (segment === 'youtube-shorts-downloader') name = 'YouTube Shorts Downloader';
    else if (segment === 'tiktok') name = 'TikTok Downloader';
    else if (segment === 'facebook') name = 'Facebook Downloader';
    else if (segment === 'pinterest') name = 'Pinterest Downloader';
    else if (segment === 'x') name = 'X Downloader';
    else if (segment === 'blog') name = 'Blog';
    else if (segment.startsWith('download-')) {
      const platformName = segment.split('-')[1] || '';
      const displayPlat = platformName.toUpperCase();
      name = `${displayPlat} Downloader`;
    }

    breadcrumbItems.push({
      '@type': 'ListItem',
      position: index + 2,
      name: name,
      item: `${siteUrl}${currentPath}`,
    });
  });
}

const breadcrumbSchema = breadcrumbItems.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems,
} : null;

// Merge schemas: always include org+website on home, plus breadcrumbs, plus page-level schemas
const allSchemas: object[] = [];

if (isHomePage) {
  allSchemas.push(orgSchema, websiteSchema);
}

if (breadcrumbSchema) {
  allSchemas.push(breadcrumbSchema);
}

if (schema) {
  if (Array.isArray(schema)) allSchemas.push(...schema);
  else allSchemas.push(schema);
}
---

<!doctype html>
<html lang={currentLang} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <link rel="canonical" href={canonical} />

    <!-- Hreflang alternates (multilingual SEO) -->
    {hreflangs.length > 0 && hreflangs.map(({ lang, url }) => (
      <link rel="alternate" hreflang={lang} href={url} />
    ))}
    {hreflangs.length > 0 && (
      <link rel="alternate" hreflang="x-default" href={canonical} />
    )}

    <!-- Open Graph -->
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url"         content={canonical} />
    <meta property="og:type"        content="website" />
    <meta property="og:image"       content={`${siteUrl}${ogImage}`} />
    <meta property="og:site_name"   content="InstaDownloader" />
    <meta property="og:locale"      content={currentLocale} />

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:site"        content="@instadownloader" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={`${siteUrl}${ogImage}`} />

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(allSchemas)} />

    <!-- AdSense -->
    {SERVE_ADS && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${AD_CLIENT}`}
        crossorigin="anonymous"
      ></script>
    )}

    <!-- Theme init: runs before first paint to avoid FOUC -->
    <script is:inline define:vars={{ SERVE_ADS }}>
      try {
        window.__SERVE_ADS__ = SERVE_ADS;
        var t = localStorage.getItem('id-theme') || 'dark';
        document.documentElement.setAttribute('data-theme', t);

        // Language Persistence
        var l = localStorage.getItem('id-lang');
        var p = window.location.pathname;
        if (l && l !== 'en' && p === '/') {
          window.location.href = '/' + l;
        }
      } catch(_) {}
    </script>
  </head>

  <body class="flex flex-col min-h-screen" style="background:var(--bg-base);color:var(--txt);font-family:'Inter',system-ui,sans-serif;">
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
